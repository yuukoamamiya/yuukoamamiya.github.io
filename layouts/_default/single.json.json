{{- $posts := where .Site.RegularPages "Type" "post" -}}
[{{- range $i, $p := $posts -}}
{{- if $i }},{{ end }}
{"title":{{ $p.Title | jsonify }},"url":{{ $p.Permalink | jsonify }},"date":{{ $p.Date.Format "2006-01-02" | jsonify }},"description":{{ $p.Description | jsonify }},"tags":{{ $p.Params.tags | jsonify }},"categories":{{ $p.Params.categories | jsonify }},"content":{{ $p.Plain | jsonify }}}
{{- end -}}]
